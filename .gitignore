# --- Secrets ---------------------------------------------------------------
# The BrAIn Key holds the ed25519 private seed: one key, one owner. It is
# minted locally by tools/make_key.py and must never leave this machine.
key/

# --- Build artifacts -------------------------------------------------------
core/target/
mind/target/

# Boot medium + world disk. Both are regenerated by ./build.sh; the world
# disk in particular is the entity's live filesystem, not source.
*.img

# --- Vendored third-party tooling ------------------------------------------
# Large local installs, fetched/built per machine rather than committed.
tools/piper/
tools/tts-env/
tools/qemu-local/

# --- Runtime state ---------------------------------------------------------
# Logs, audio/video FIFO dirs, lockfiles and programs the entity wrote itself.
workspace/

__pycache__/
*.pyc
