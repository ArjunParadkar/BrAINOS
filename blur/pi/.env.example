# BLUR Pi secrets. Copy to blur/pi/.env and fill in. .env is gitignored;
# never commit real keys. Load with:  set -a; . blur/pi/.env; set +a

# Claude (voice LLM + robot tool calls). Model is claude-haiku-5-5 for speed.
ANTHROPIC_API_KEY=

# Text-to-speech. Cartesia Sonic is primary (lowest streaming latency).
CARTESIA_API_KEY=
# Optional quality fallback:
ELEVENLABS_API_KEY=

# Streaming speech-to-text (Deepgram-class). Optional: local Whisper is the
# offline fallback if this is unset.
DEEPGRAM_API_KEY=
