# finalbody campaign settings (sourced by every lane job). Same discipline as
# day-one, but retargeted to the FINAL body: the descriptor and the MJCF both
# point at BLUR_final, and blurcfg's sha-check enforces it.
export BLUR_DESCRIPTOR=$BLUR_CODE/blur/descriptor_final.json
export BLUR_MJCF_DIR=/scrfs/storage/paradkar/blur/mjcf/blur_final
export BLUR_DR=wide
export WORKERS=28 ENVS=4
export CKPT_MIN=15
export EVAL_EPISODES=200 EVAL_PROCS=25 EVAL_NEED_S=600
