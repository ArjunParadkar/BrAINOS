# site/pinnacle.env -- BLUR on AHPCC Pinnacle. `source` it (jobs do this).
# The only things that differ from the laptop are WHERE files live and HOW
# python is started; the code is the same tree (rsync'd by sync_to_pinnacle.sh).
export BLUR_SITE=pinnacle
export BLUR_HOME=/scrfs/storage/$USER/blur               # images, code copy, MJCF copy, runs, logs
export BLUR_CODE=$BLUR_HOME/code/blur                    # = the repo's blur/ directory
export BLUR_MJCF_DIR=$BLUR_HOME/mjcf/blur_mujoco_v36     # read-only copy of BLUR/blur_mujoco_v36 (sha-checked by blurcfg)
export BLUR_SIF=$BLUR_HOME/images/blur-mjx-0.12-mj3.16.sif
export BLUR_RUNS=$BLUR_HOME/runs
export BLUR_LOGS=$BLUR_HOME/logs
export BLUR_PY=$BLUR_CODE/hpcc/bpy                       # python inside the image (adds --nv on GPU nodes)
export SINGULARITY_CACHEDIR=$BLUR_HOME/cache/singularity
export OMP_NUM_THREADS=${SLURM_CPUS_PER_TASK:-1}        # the site exports 1; set it explicitly
export XLA_PYTHON_CLIENT_MEM_FRACTION=0.90
